##################################################################
## ncmpcpp bindings — vim-style navigation                      ##
##                                                               ##
## Keys not listed here keep their ncmpcpp defaults              ##
## (q quit, p pause, s stop, </> prev/next, f/b seek,            ##
##  z random, r repeat, u update, 1-8 screens, : command ...).   ##
##                                                                ##
## ncmpcpp has no multi-key chords, so "gg" is just "g".         ##
## Rules: several `def_key "x"` blocks = first one that can run;  ##
## several actions in one block = a chain that stops at a failure.##
##################################################################


##### movement (vim) #####

def_key "j"
  scroll_down

def_key "k"
  scroll_up

def_key "ctrl-d"
  page_down

def_key "ctrl-u"
  page_up

def_key "J"
  page_down

def_key "K"
  page_up

def_key "g"
  move_home

def_key "0"
  move_home

def_key "G"
  move_end

def_key "$"
  move_end

def_key "H"
  previous_column

def_key "L"
  next_column

def_key "L"
  show_lyrics


##### open / close (netrw-style) #####

def_key "h"
  jump_to_parent_directory

def_key "l"
  enter_directory

def_key "l"
  play_item


##### search (vim) #####

def_key "/"
  find

def_key "/"
  find_item_forward

def_key "?"
  find

def_key "?"
  find_item_backward

def_key "n"
  next_found_item

def_key "N"
  previous_found_item


##### selection (vim visual) #####

def_key "v"
  select_item

def_key "V"
  remove_selection

def_key "alt-v"
  reverse_selection

def_key "ctrl-v"
  select_range

def_key "B"
  select_album


##### playlist editing #####

def_key "a"
  add_selected_items

def_key "a"
  add_item_to_playlist

def_key "d"
  delete_playlist_items

def_key "d"
  delete_browser_items

def_key "d"
  delete_stored_playlist

def_key "alt-j"
  move_selected_items_down

def_key "alt-k"
  move_selected_items_up


##### playback #####

def_key "space"
  pause

def_key "alt-t"
  toggle_visualization_type

def_key "alt-y"
  toggle_lyrics_update_on_song_change


##### screen jumps (G moved to end-of-list) #####

def_key "alt-b"
  jump_to_browser

def_key "alt-e"
  jump_to_playlist_editor

def_key "alt-m"
  jump_to_media_library

def_key "alt-p"
  jump_to_playlist_editor

def_key "ctrl-g"
  jump_to_position_in_song
