set statusbar-h-padding 0
set statusbar-v-padding 0
set selection-clipboard clipboard
set guioptions ''
set adjust-open width
set font 'sans-serif normal 14'

map <A-i> zoom in
map <A-o> zoom out
map u scroll half-up
map d scroll half-down
map <C-d> toggle_page_mode
map f toggle_fullscreen
map <C-f> follow

map [fullscreen] <A-i> zoom in
map [fullscreen] <A-o> zoom out
map [fullscreen] u scroll half-up
map [fullscreen] d scroll half-down
map [fullscreen] <C-d> toggle_page_mode
map [fullscreen] f toggle_fullscreen
map [fullscreen] <C-f> follow

include gruvbox.color
